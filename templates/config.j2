{% if awscli_users[__awscli_user]['default']['config'] is not defined %}
[default]
{% for key,data in awscli_defaultconfig.items() %}
{{ key }} = {{ data }}
{% endfor %}
{% endif %}
{% if awscli_users[__awscli_user] is defined and awscli_users[__awscli_user] is iterable %}
{% for awscli_profiles in awscli_users[__awscli_user] %}
{% if awscli_users[__awscli_user][awscli_profiles]['config'] is defined %}
{% if awscli_profiles=='default' %}
[{{ awscli_profiles }}]
{% else %}
[profile {{ awscli_profiles }}]
{% endif %}
{% for key,data in awscli_users[__awscli_user][awscli_profiles]['config'].items() %}
{{ key }} = {{ data }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
